NODE_ENV=development
PORT=3000

MONGODB_URI=
REDIS_URL=
VERDICT_CACHE_TTL_SECONDS=3600

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=180
# Comma-separated. Leave empty to disable that sign-in method.
# Google: include the WEB client ID — with Android Credential Manager the
# ID token's audience is the web client passed as serverClientId, not the
# Android client. Add the iOS client ID too if iOS uses Google Sign-In.
GOOGLE_CLIENT_IDS=
# Apple: the iOS bundle ID (and the Services ID if you add web sign-in).
APPLE_CLIENT_IDS=
# Required when APPLE_CLIENT_IDS is set. From Apple Developer > Keys (Sign in
# with Apple). APPLE_PRIVATE_KEY is the .p8 content on one line with \n escapes.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Apple
# refresh tokens so account deletion can revoke them.
TOKEN_ENCRYPTION_KEY=
ADMIN_EMAIL=

S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
S3_FORCE_PATH_STYLE=

VISION_PROVIDER=stub
# tiered = Gemini Flash primary (via OpenRouter) escalating to Claude Sonnet
# on failure/low confidence — needs both keys below. See HLD §9.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_OPENROUTER_MODEL=google/gemini-2.5-flash
WORKER_MODE=false
# Dev seed (NODE_ENV=development): HLD rule_sets v1, diabetic personalization,
# and fixture barcode 8900000000000 for GET /products/:barcode without AI.
