{
  "info": {
    "name": "ScanBite API",
    "description": "Backend for a packaged-food label scanner (India). See apps/api/README.md for setup. \"Create anonymous account\" auto-captures the tokens and default member_id into collection variables — run those first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "member_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "barcode",
      "value": "8900000000000",
      "type": "string"
    },
    {
      "key": "submission_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "unresolved_term_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Not under /v1 — pings Mongo, Redis, and S3."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Create anonymous account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/anonymous",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "anonymous"]
            },
            "description": "What the app calls on first open. Creates an account with a default 'self' household member. Sets {{token}}, {{refresh_token}} and {{member_id}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "if (json.user && json.user.default_member_id) pm.collectionVariables.set('member_id', json.user.default_member_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh tokens",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            },
            "description": "Swaps the refresh token for a new access + refresh pair. Each refresh token works once (a retry within 60 s is tolerated).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "if (json.user && json.user.default_member_id) pm.collectionVariables.set('member_id', json.user.default_member_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Google",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/google",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "google"]
            },
            "description": "Send with the current Bearer token to link Google to that (anonymous) account; without it, signs in or creates an account. Needs GOOGLE_CLIENT_IDS, otherwise 503.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"<ID token from the Google SDK>\",\n  \"nonce\": \"<raw nonce; its SHA-256 hex was given to the SDK>\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "if (json.user && json.user.default_member_id) pm.collectionVariables.set('member_id', json.user.default_member_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in with Apple",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/apple",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "apple"]
            },
            "description": "Like Google, plus the authorization code (validated with Apple) and the first name Apple shares only once. Needs the Apple settings in .env, otherwise 503.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_token\": \"<identity token from Apple>\",\n  \"nonce\": \"<raw nonce>\",\n  \"authorization_code\": \"<one-time code from Apple>\",\n  \"given_name\": \"<optional, first sign-in only>\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) pm.collectionVariables.set('token', json.access_token);",
                  "if (json.refresh_token) pm.collectionVariables.set('refresh_token', json.refresh_token);",
                  "if (json.user && json.user.default_member_id) pm.collectionVariables.set('member_id', json.user.default_member_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            },
            "description": "Ends this session (revokes the refresh token). Returns 204.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "me"]
            },
            "description": "Current user + full household member list."
          },
          "response": []
        },
        {
          "name": "Delete account",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/me",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "me"]
            },
            "description": "Deletes the account and everything tied to it (household, scans, submissions + photos, sessions) and revokes Apple tokens. Returns 204."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Household Members",
      "item": [
        {
          "name": "List household members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/household-members",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "household-members"]
            }
          },
          "response": []
        },
        {
          "name": "Create household member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grandma\",\n  \"relationship\": \"parent\",\n  \"age_band\": \"60+\",\n  \"conditions\": [\"diabetic\", \"hypertensive\"],\n  \"allergies\": [\"peanuts\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/household-members",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "household-members"]
            },
            "description": "relationship: self | spouse | child | parent | other. conditions must be from the canonical list: diabetic, hypertensive, obesity, cardiovascular, dyslipidemia, chronic_kidney_disease, fatty_liver, gout, pcos, hypothyroidism."
          },
          "response": []
        },
        {
          "name": "Update household member",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conditions\": [\"diabetic\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/household-members/{{member_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "household-members", "{{member_id}}"]
            },
            "description": "Partial update — at least one field required. age_band: omit to leave unchanged, null to clear, a value to set."
          },
          "response": []
        },
        {
          "name": "Delete household member",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/household-members/{{member_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "household-members", "{{member_id}}"]
            },
            "description": "204 on success. Cannot delete a user's own default member (403)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Lookup product by barcode",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/products/{{barcode}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products", "{{barcode}}"]
            },
            "description": "Read-only view (Explore, tapping a recent scan) — does not record a scan; the scanner uses POST /v1/scans. Returns a verdict for every household member plus `overall`. 8900000000000 is the dev fixture barcode. Unknown barcodes return {\"found\": false}, not a 404; a barcode that isn't 8–14 digits is a 400."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "Submit label photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.submission_id) pm.collectionVariables.set('submission_id', json.submission_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "photo",
                  "type": "file",
                  "src": [],
                  "description": "Max 10MB. VISION_PROVIDER=stub means the actual photo content doesn't affect extraction yet."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/products/1234567890123/submissions",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "products", "1234567890123", "submissions"]
            },
            "description": "Returns 202 immediately; extraction runs async on the worker process. Sets {{submission_id}} on success."
          },
          "response": []
        },
        {
          "name": "Get submission status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/submissions/{{submission_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "submissions", "{{submission_id}}"]
            },
            "description": "status: processing -> ready | needs_review | failed. Requires the worker process to be running to ever leave 'processing'. Only visible to the submitting user."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Scans",
      "item": [
        {
          "name": "Scan a product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"barcode\": \"{{barcode}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/scans",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "scans"]
            },
            "description": "What the scanner calls: looks the product up (importing from Open Food Facts on first sight), records every household member's verdict at this moment, and returns {scan_id, result} where result is the same body as GET /products/:barcode. Add \"member_id\" for \"Scan for <member>\"; leave it out for everyone."
          },
          "response": []
        },
        {
          "name": "Recent scans (household)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/scans?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "scans"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "from",
                  "value": "",
                  "disabled": true,
                  "description": "ISO datetime"
                },
                {
                  "key": "to",
                  "value": "",
                  "disabled": true,
                  "description": "ISO datetime"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true,
                  "description": "id of the last item from a previous page, for keyset pagination"
                }
              ]
            },
            "description": "Home recents: newest first, each with the product and every member's verdict at scan time."
          },
          "response": []
        },
        {
          "name": "Scans for a member",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/household-members/{{member_id}}/scans?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "household-members", "{{member_id}}", "scans"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "from",
                  "value": "",
                  "disabled": true,
                  "description": "ISO datetime"
                },
                {
                  "key": "to",
                  "value": "",
                  "disabled": true,
                  "description": "ISO datetime"
                },
                {
                  "key": "cursor",
                  "value": "",
                  "disabled": true,
                  "description": "id of the last item from a previous page, for keyset pagination"
                }
              ]
            },
            "description": "Scans made for this member (\"Scan for ...\"). Household-wide recents are GET /v1/scans."
          },
          "response": []
        },
        {
          "name": "Household summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/household-members/{{member_id}}/summary?period=week",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "household-members", "{{member_id}}", "summary"],
              "query": [
                {
                  "key": "period",
                  "value": "week",
                  "description": "week | month"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List unresolved ingredient terms",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.items && json.items.length > 0) pm.collectionVariables.set('unresolved_term_id', json.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/admin/unresolved-terms",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "admin", "unresolved-terms"]
            },
            "description": "Requires the admin role — sign in with Google as ADMIN_EMAIL from .env, or set role: \"admin\" on the user in Mongo. Sets {{unresolved_term_id}} from the first result."
          },
          "response": []
        },
        {
          "name": "Resolve unresolved term (existing ingredient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"canonical_ingredient_id\": \"<existing ingredient _id>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/unresolved-terms/{{unresolved_term_id}}/resolve",
              "host": ["{{baseUrl}}"],
              "path": [
                "v1",
                "admin",
                "unresolved-terms",
                "{{unresolved_term_id}}",
                "resolve"
              ]
            },
            "description": "Provide exactly one of canonical_ingredient_id or new_ingredient — see the sibling request for the new_ingredient form."
          },
          "response": []
        },
        {
          "name": "Resolve unresolved term (new ingredient)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"new_ingredient\": {\n    \"canonical_name\": \"Palm Kernel Oil\",\n    \"category\": \"palm_oil\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/unresolved-terms/{{unresolved_term_id}}/resolve",
              "host": ["{{baseUrl}}"],
              "path": [
                "v1",
                "admin",
                "unresolved-terms",
                "{{unresolved_term_id}}",
                "resolve"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
