{
  "expo": {
    "name": "ScanBite",
    "slug": "scanbite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scanbite",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.scanbite.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "in.scanbite.app",
      "adaptiveIcon": {
        "backgroundColor": "#3A6EC4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3A6EC4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "ScanBite uses the camera to read barcodes and product labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#3A6EC4"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09484739-1cbe-4913-a168-db27d91801b1"
      }
    },
    "owner": "kartik_j"
  }
}
